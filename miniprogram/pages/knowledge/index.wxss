.container {
  min-height: 100vh;
  background: #F5F7FA;
}

.page-header {
  padding: 32rpx 40rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #F1F5F9;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0F172A;
}

.content {
  padding: 40rpx 40rpx 120rpx;
}

.knowledge-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
}

.knowledge-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  border: 2rpx solid #F1F5F9;
  min-height: 240rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: #F0FDFA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.card-icon svg {
  width: 42rpx;
  height: 42rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.card-desc {
  font-size: 24rpx;
  color: #64748B;
  line-height: 1.7;
  flex: 1;
}

.source {
  font-size: 22rpx;
  color: #94A3B8;
  text-align: center;
  margin-top: 56rpx;
}
