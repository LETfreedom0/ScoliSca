page {
  background-color: #F5F7FA;
  padding-bottom: 50px;
  font-family: 'PingFang SC', 'Microsoft YaHei', -apple-system, 'Helvetica Neue', sans-serif;
}

.page-container {
  padding: 24rpx 40rpx;
}

.tip {
  font-size: 24rpx;
  color: #64748B;
  width: 90%;
  text-align: center;
  margin: 40rpx auto 0 auto;
}

.top_tip {
  font-size: 28rpx;
  color: #64748B;
  width: 100%;
  text-align: left;
  margin-top: 32rpx;
}

.box_text {
  background-color: #FFFFFF;
  text-align: center;
  padding: 200rpx 0;
  margin-top: 32rpx;
  color: #64748B;
  border-radius: 28rpx;
  border: 2rpx solid #F1F5F9;
}

.button {
  width: 320rpx;
  text-align: center;
  margin: 160rpx auto 0 auto;
  height: 88rpx;
  color: white;
  border-radius: 44rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #0D9488, #14B8A6);
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(13, 148, 136, 0.25);
}

.button_clear {
  width: 320rpx;
  text-align: center;
  margin: 24rpx auto 0 auto;
  height: 88rpx;
  color: #0D9488;
  border-radius: 44rpx;
  line-height: 88rpx;
  background-color: #FFFFFF;
  border: 3rpx solid #0D9488;
  font-size: 30rpx;
  font-weight: 600;
}

.line {
  height: 2rpx;
  width: 100%;
  background-color: #F1F5F9;
  margin: 32rpx 0;
}

.code_box {
  text-align: center;
  background-color: #FFFFFF;
  margin-top: 32rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #F1F5F9;
}

.code_box_title {
  color: #64748B;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  text-align: left;
}

.code_box_record {
  display: flex;
}

.code_box_record_title {
  width: 33%;
  font-size: 26rpx;
  color: #64748B;
  padding: 20rpx 0;
}

.code_box_record_detail {
  width: 25%;
  font-size: 26rpx;
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  margin-top: 20rpx;
  margin-bottom: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #0F172A;
}

.info {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #64748B;
  line-height: 56rpx;
}

.img {
  width: 100%;
  border-radius: 20rpx;
  margin-top: 16rpx;
}

.step-img {
  margin-top: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.code_img {
  width: 360rpx;
  height: 360rpx;
}

.block {
  font-size: 28rpx;
  line-height: 48rpx;
}

.step-left {
  color: #FFF;
  background-color: #0D9488;
  border: #0D9488 solid 1rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.step-right {
  color: #0D9488;
  background-color: #FFFFFF;
  border: #0D9488 solid 1rpx;
  padding: 4rpx 12rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.code_zone {
  background-color: #0E190E;
  color: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  padding: 24rpx 36rpx;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
  position: relative;
  margin-bottom: 32rpx;
}

.btn-full {
  height: 88rpx;
  border-radius: 44rpx;
  line-height: 88rpx;
  color: #fff;
  background: linear-gradient(135deg, #0D9488, #14B8A6);
  text-align: center;
  margin-bottom: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 28rpx rgba(13, 148, 136, 0.25);
}

.step-title {
  line-height: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
}

.step-text {
  font-size: 26rpx;
  line-height: 40rpx;
  padding: 16rpx 0;
  text-align: justify;
  color: #64748B;
}

.modal-mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center;
}

.modal-content {
  background: #fff; padding: 32rpx; border-radius: 24rpx; width: 85%;
}

.modal-title { font-size: 32rpx; margin-bottom: 20rpx; font-weight: 600; color: #0F172A; }

.modal-input { margin-bottom: 16rpx; border: 2rpx solid #E2E8F0; padding: 20rpx; border-radius: 12rpx; width: 100%; font-size: 28rpx; }

.modal-actions { display: flex; justify-content: flex-end; gap: 20rpx; }

.notice-box {
  background: linear-gradient(135deg, #fff8e6 0%, #fff3d9 100%);
  border-left: 6rpx solid #D97706;
  border-radius: 12rpx;
  padding: 24rpx;
  margin: 24rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.1);
}

.notice-text {
  font-size: 26rpx;
  color: #92400E;
  line-height: 44rpx;
}

.notice-highlight {
  color: #D97706;
  font-weight: 600;
}

.shortcut-box {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx;
  margin: 24rpx 0;
  border: 2rpx solid #F1F5F9;
}

.shortcut-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.shortcut-item:last-child {
  margin-bottom: 0;
}

.shortcut-label {
  font-size: 28rpx;
  color: #0F172A;
  width: 260rpx;
  flex-shrink: 0;
}

.shortcut-key {
  font-size: 28rpx;
  color: #0D9488;
  font-weight: 600;
  background-color: #F0FDFA;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  white-space: nowrap;
}

.plugin-name-box {
  background-color: #F0FDFA;
  border-left: 6rpx solid #0D9488;
  padding: 24rpx;
  margin: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.plugin-name {
  font-size: 32rpx;
  color: #0D9488;
  font-weight: 600;
  flex: 1;
}

.copy-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: rgba(13, 148, 136, 0.1);
  border: 2rpx solid rgba(13, 148, 136, 0.3);
  border-radius: 12rpx;
  margin-left: 24rpx;
  transition: all 0.2s;
}

.copy-btn:active {
  background-color: rgba(13, 148, 136, 0.2);
}

.copy-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  filter: invert(52%) sepia(73%) saturate(2034%) hue-rotate(90deg) brightness(92%) contrast(84%);
}

.copy-text {
  font-size: 26rpx;
  color: #0D9488;
  font-weight: 600;
}

.divider {
  height: 2rpx;
  width: 100%;
  background-color: #F1F5F9;
  margin: 48rpx 0;
}

.feature-section {
  margin-top: 24rpx;
}

.feature-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 24rpx;
}

.feature-list {
  padding-left: 0;
}

.feature-item {
  font-size: 28rpx;
  color: #64748B;
  line-height: 56rpx;
  margin-bottom: 16rpx;
}

.feature-item-with-examples {
  margin-bottom: 24rpx;
  padding: 28rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #F1F5F9;
}

.feature-item-with-examples:last-child {
  margin-bottom: 0;
}

.feature-main {
  font-size: 30rpx;
  font-weight: 600;
  color: #0F172A;
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.feature-examples {
  padding-left: 0;
}

.feature-example {
  font-size: 26rpx;
  color: #64748B;
  line-height: 48rpx;
  margin-bottom: 12rpx;
}

.feature-example-wrapper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
  padding: 12rpx 16rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
}

.feature-example-text {
  flex: 1;
  font-size: 26rpx;
  color: #64748B;
  line-height: 44rpx;
}

.feature-copy-btn {
  padding: 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
  transition: all 0.2s;
  background: #FFFFFF;
  border: 2rpx solid #E2E8F0;
}

.feature-copy-btn:active {
  background-color: #F1F5F9;
}

.feature-copy-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
  transition: opacity 0.2s;
}

.feature-copy-btn:active .feature-copy