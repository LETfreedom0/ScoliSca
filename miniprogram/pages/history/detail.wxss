.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAFC 0%, #F1F5F9 100%);
}

.page-header {
  display: flex;
  align-items: center;
  padding: 28rpx 40rpx;
  background: #FFFFFF;
  border-bottom: 2rpx solid #E2E8F0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F8FAFC;
  transition: all 0.2s ease;
}

.back-btn:active {
  background: #E2E8F0;
  transform: scale(0.95);
}

.back-btn svg {
  width: 36rpx;
  height: 36rpx;
}

.header-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0F172A;
  letter-spacing: 1rpx;
}

.type-badge {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: #CCFBF1;
  color: #115E59;
}

.type-badge text {
  font-size: inherit;
  font-weight: inherit;
  color: inherit;
}

.content {
  padding: 40rpx;
}

.result-card {
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 2rpx solid #F1F5F9;
  margin-bottom: 40rpx;
  position: relative;
  overflow: hidden;
}

.card-accent {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, #059669 0%, #D97706 50%, #DC2626 100%);
}

.record-date {
  font-size: 24rpx;
  color: #64748B;
  margin-bottom: 24rpx;
  display: block;
}

.cobb-value {
  font-size: 110rpx;
  font-weight: 800;
  color: #D97706;
  line-height: 1;
  letter-spacing: -4rpx;
  display: block;
  margin-top: 16rpx;
}

.cobb-label {
  font-size: 30rpx;
  color: #64748B;
  font-weight: 500;
  margin-top: 20rpx;
  display: block;
}

.result-badge {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 32rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  color: #D97706;
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.2);
}

.risk-ring {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 0 auto 40rpx;
}

.ring-bg {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #D1FAE5;
  opacity: 0.5;
  filter: blur(32rpx);
}

.ring-svg {
  width: 100%;
  height: 100%;
}

.ring-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
}

.risk-level {
  font-size: 56rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1.1;
}

.risk-label {
  font-size: 20rpx;
  color: #475569;
  margin-top: 4rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 12rpx;
  display: block;
}

.result-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.6;
}

.severity-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  border: 2rpx solid #F1F5F9;
  margin-bottom: 40rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.severity-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 32rpx;
  display: block;
}

.severity-bars {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.severity-item {
  flex: 1;
  text-align: center;
  transition: all 0.3s ease;
}

.bar {
  height: 28rpx;
  border-radius: 14rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #E2E8F0;
  background: #F8FAFC;
  transition: all 0.3s ease;
}

.severity-item.normal .bar {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
  border-color: #34D399;
}

.severity-item.mild .bar {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-color: #F59E0B;
}

.severity-item.moderate .bar {
  background: linear-gradient(135deg, #FED7AA 0%, #FDBA74 100%);
  border-color: #F97316;
}

.severity-item.severe .bar {
  background: linear-gradient(135deg, #FECACA 0%, #FCA5A5 100%);
  border-color: #EF4444;
}

.severity-item.extreme .bar {
  background: linear-gradient(135deg, #FBCFE8 0%, #F9A8D4 100%);
  border-color: #DB2777;
}

.severity-item.active {
  transform: scale(1.08);
}

.severity-item.active .bar {
  box-shadow: 0 6rpx 20rpx rgba(217, 119, 6, 0.3);
}

.severity-item.active .label {
  color: #D97706;
  font-weight: 700;
}

.label {
  font-size: 24rpx;
  color: #64748B;
  margin-bottom: 6rpx;
  display: block;
}

.range {
  font-size: 22rpx;
  color: #94A3B8;
  display: block;
}

.severity-scale {
  margin-top: 24rpx;
  position: relative;
  padding-top: 40rpx;
}

.scale-bar {
  width: 100%;
  height: 16rpx;
  border-radius: 8rpx;
  display: flex;
  overflow: hidden;
}

.scale-segment {
  flex: 1;
}

.scale-segment.normal {
  background: #059669;
}

.scale-segment.mild {
  background: #D97706;
}

.scale-segment.moderate {
  background: #EA580C;
}

.scale-segment.severe {
  background: #DC2626;
}

.scale-segment.extreme {
  background: #DB2777;
}

.scale-marker {
  position: absolute;
  top: 16rpx;
  left: 46%;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 6rpx solid #D97706;
  box-shadow: 0 0 0 8rpx rgba(217, 119, 6, 0.2), 0 8rpx 24rpx rgba(217, 119, 6, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 8rpx rgba(217, 119, 6, 0.2), 0 8rpx 24rpx rgba(217, 119, 6, 0.3);
  }
  50% {
    transform: scale(1.1);
    box-shadow: 0 0 0 12rpx rgba(217, 119, 6, 0.15), 0 8rpx 24rpx rgba(217, 119, 6, 0.3);
  }
}

.scale-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.scale-labels text {
  font-size: 20rpx;
  color: #94A3B8;
}

.analysis-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 24rpx;
  display: block;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #F59E0B 0%, #D97706 100%);
  border-radius: 3rpx;
}

.annotation-image {
  background: #FFFFFF;
  border-radius: 32rpx;
  height: 380rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #F1F5F9;
  overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.annotation-svg {
  width: 380rpx;
  height: 340rpx;
}

.image-hint {
  font-size: 22rpx;
  color: #94A3B8;
  text-align: center;
  margin-top: 16rpx;
  display: block;
}

.detail-section {
  margin-bottom: 40rpx;
}

.info-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid #F1F5F9;
  transition: all 0.2s ease;
}

.info-card:active {
  transform: scale(0.98);
  box-shadow: inset 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.info-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.info-label {
  font-size: 28rpx;
  color: #334155;
  font-weight: 600;
}

.info-hint {
  font-size: 22rpx;
  color: #94A3B8;
}

.info-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #0F172A;
}

.info-value.warning {
  color: #D97706;
}

.info-value.safe {
  color: #059669;
}

.advice-section {
  margin-bottom: 40rpx;
}

.advice-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  border: 2rpx solid #F1F5F9;
}

.advice-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F1F5F9;
}

.advice-item:last-child {
  border-bottom: none;
}

.advice-icon {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ECFDF5;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.advice-icon svg {
  width: 20rpx;
  height: 20rpx;
}

.advice-text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.7;
}

.warning-card {
  background: linear-gradient(135deg, #FEFCE8 0%, #FEF3C7 100%);
  border-radius: 32rpx;
  padding: 36rpx;
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  border: 2rpx solid #FDE68A;
  margin-bottom: 40rpx;
}

.warning-icon-wrapper {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(217, 119, 6, 0.15);
}

.warning-icon-wrapper svg {
  width: 36rpx;
  height: 36rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #92400E;
  line-height: 1.8;
  flex: 1;
}

.action-buttons {
  display: flex;
  gap: 28rpx;
  margin-bottom: 40rpx;
}

.btn-full {
  flex: 1;
  padding: 26rpx 0;
  text-align: center;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  transition: all 0.2s ease;
}

.btn-full:active {
  transform: scale(0.98);
}

.primary-btn {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(5, 150, 105, 0.3);
}

.danger-btn {
  background: #FFFFFF;
  color: #DC2626;
  border: 2rpx solid #FCA5A5;
}

.disclaimer {
  font-size: 22rpx;
  color: #94A3B8;
  text-align: center;
  line-height: 1.7;
  padding: 20rpx 0 40rpx;
}