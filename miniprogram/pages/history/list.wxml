<view class="container">
  <view class="content">
    <text class="record-count">共 {{records.length}} 条记录</text>

    <view class="record-list">
      <view
        class="swipe-container"
        wx:for="{{records}}"
        wx:key="id"
      >
        <view
          class="del-btn"
          bindtap="deleteSingle"
          data-id="{{item.id}}"
        >
          <text>删除</text>
        </view>
        <view
          class="record-item"
          bindtap="goToDetail"
          data-record="{{item}}"
          bindtouchstart="touchStart"
          bindtouchmove="touchMove"
          bindtouchend="touchEnd"
          data-id="{{item.id}}"
          style="transform: translateX({{delBtnStatus[item.id] || 0}}px)"
        >
          <view class="record-icon-wrap">
            <view class="record-icon {{item.type === 'xray' ? 'xray' : 'photo'}}">
              <svg wx:if="{{item.type === 'xray'}}" viewBox="0 0 24 24" fill="none">
                <rect x="4" y="2" width="16" height="20" rx="3" stroke="#4F46E5" stroke-width="1.8" fill="none"/>
                <path d="M7 7h10M7 11h8M7 15h6" stroke="#4F46E5" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <svg wx:else viewBox="0 0 24 24" fill="none">
                <rect x="3" y="6" width="18" height="13" rx="2" stroke="#0D9488" stroke-width="1.8" fill="none"/>
                <circle cx="12" cy="12.5" r="3" stroke="#0D9488" stroke-width="1.8" fill="none"/>
              </svg>
            </view>
          </view>
          <view class="record-info">
            <view class="record-header">
              <view class="left-badges">
                <view class="type-badge {{item.type === 'xray' ? 'blue' : 'teal'}}">
                  {{item.type === 'xray' ? 'X光片' : '后背照片'}}
                </view>
                <view class="risk-badge {{item.riskLevel}}">
                  <view class="risk-dot"></view>
                  <text>{{item.riskLevelText}}</text>
                </view>
              </view>
              <text class="record-date">{{item.date}}</text>
            </view>
            <text class="record-result" wx:if="{{item.abnormalSigns.length > 0}}">{{item.abnormalSignsText}}</text>
            <text class="record-result normal" wx:else>体态基本正常</text>
          </view>
          <view class="record-arrow">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M9 6l6 6-6 6" stroke="#C0C8D0" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </view>
        </view>
      </view>
    </view>

    <text class="swipe-hint">← 左滑可删除单条记录</text>

    <view class="clear-all" bindtap="clearAll">
      <text>清空全部记录</text>
    </view>
  </view>
</view>
