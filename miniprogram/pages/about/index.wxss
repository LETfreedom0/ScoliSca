.container {
  min-height: 100vh;
  background: #F5F7FA;
}

.content {
  padding: 80rpx 48rpx 120rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 144rpx;
  height: 144rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0D9488 0%, #14B8A6 50%, #2DD4BF 100%);
  margin: 0 auto 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 56rpx rgba(13, 148, 136, 0.28);
}

.logo svg {
  width: 72rpx;
  height: 72rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #0F172A;
  display: block;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}

.app-version {
  font-size: 26rpx;
  color: #94A3B8;
  display: block;
}

.feature-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-bottom: 64rpx;
}

.feature-item {
  display: flex;
  gap: 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 36rpx;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.feature-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #F0FDFA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.feature-icon svg {
  width: 44rpx;
  height: 44rpx;
}

.feature-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.feature-desc {
  font-size: 26rpx;
  color: #64748B;
  line-height: 1.9;
}

.warning-card {
  background: #FEF3C7;
  border-radius: 32rpx;
  padding: 40rpx 44rpx;
  border: 2rpx solid #FDE68A;
  margin-bottom: 56rpx;
}

.warning-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #D97706;
  margin-bottom: 24rpx;
  display: block;
}

.warning-text {
  font-size: 26rpx;
  color: #92400E;
  line-height: 2.1;
  text-indent: 52rpx;
  letter-spacing: 0.5rpx;
}

.privacy-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 44rpx;
  border: 2rpx solid #F1F5F9;
  margin-bottom: 56rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.privacy-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 24rpx;
  display: block;
}

.privacy-text {
  font-size: 26rpx;
  color: #64748B;
  line-height: 2.1;
  text-indent: 52rpx;
  letter-spacing: 0.5rpx;
}

.links {
  display: flex;
  justify-content: center;
  gap: 80rpx;
  padding-top: 32rpx;
}

.link-item {
  font-size: 28rpx;
  color: #0D9488;
  font-weight: 600;
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  transition: all 0.2s;
}

.link-item:active {
  background: rgba(13, 148, 136, 0.08);
}
