page {
  background: #F5F7FA;
  font-family: 'PingFang SC', 'Microsoft YaHei', -apple-system, 'Helvetica Neue', sans-serif;
  font-size: 14px;
  line-height: 1.6;
  color: #0F172A;
  -webkit-font-smoothing: antialiased;
}

.container {
  min-height: 100vh;
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
  outline: none;
}

button::after {
  border: none;
}

.page-content {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.page-header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #0F172A;
}

.page-header-back {
  margin-right: 16rpx;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 48rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #0D9488 0%, #0F766E 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  box-shadow: 0 8rpx 28rpx rgba(13, 148, 136, 0.25);
}

.secondary-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 48rpx;
  border-radius: 48rpx;
  background: #FFFFFF;
  color: #0D9488;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  border: 3rpx solid #0D9488;
}

.danger-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 48rpx;
  border-radius: 48rpx;
  background: transparent;
  color: #DC2626;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.3rpx;
  border: 3rpx solid #DC2626;
}

.safe-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  background: #D1FAE5;
  color: #059669;
}

.warning-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  background: #FEF3C7;
  color: #D97706;
}

.danger-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  background: #FEE2E2;
  color: #DC2626;
}

.primary-badge {
  display: inline-block;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.2rpx;
  background: #CCFBF1;
  color: #115E59;
}

.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid #F1F5F9;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 20rpx;
  padding-top: 12rpx;
  letter-spacing: 0.3rpx;
}

.info-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid #F1F5F9;
}

.info-card-label {
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
}

.info-card-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.info-card-value-safe {
  color: #059669;
}

.info-card-value-warning {
  color: #D97706;
}

.info-card-value-danger {
  color: #DC2626;
}

.mock-image {
  width: 100%;
  height: 320rpx;
  background: #F1F5F9;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #94A3B8;
  letter-spacing: 0.3rpx;
  border: 2rpx dashed #E2E8F0;
}

